# From https://discord.com/developers/applications → your app
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=paste-your-application-id-here

# Your test server's ID (right-click the server → Copy Server ID). Makes commands show up instantly.
GUILD_ID=

# Folder with your .mp3 / .flac / .wav / .ogg / .m4a files
MUSIC_DIR=./music
